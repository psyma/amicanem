@page "/"
@using amicanem.Shared.Service.AppEvent
@using amicanem.Shared.Service.Platform

@inject IPlatformService PlatformService
@inject IAppEventService AppEventService

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

<div>
    <p class="text-red-500">tailwindcss</p>
    Welcome to your new app. @PlatformService.PlatformName
    <p>Clicks: @count</p>
    <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary">Hello World!</MudButton>
</div>

@code {
    private int count;

    protected override void OnInitialized()
    {
        AppEventService.MenuClicked += OnMenuClicked;
    }

    private void OnMenuClicked()
    {
        count++;
        Console.WriteLine(count);
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AppEventService.MenuClicked -= OnMenuClicked;
    }
}